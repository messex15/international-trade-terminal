# Freight Desk settings. Copy to .env for local development with `netlify dev`.
# Generate a real value with: npm run secrets
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: public address used when building client links.
# PUBLIC_BASE_URL=https://your-site.netlify.app

# Optional: Identity role allowed to use the desk and manage client links (default: member).
# FREIGHT_MEMBER_ROLE=member

# Optional: CN API connection (staff only). The key and secret of an app registered
# in CN's developer portal (developer.app.cn.ca) under the CN account and activated
# by CN. Set them in Netlify (Site configuration > Environment variables), never in
# a committed file.
# CN_API_KEY=
# CN_API_SECRET=

# Local testing only: a stand-in for Netlify Identity's API. Never set this in production.
# IDENTITY_API_URL=http://localhost:9999
