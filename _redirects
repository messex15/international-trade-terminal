# Keep server code and tooling files off the public site
/netlify/*          /404  404!
/scripts/*          /404  404!
/test/*             /404  404!
/package.json       /404  404!
/package-lock.json  /404  404!
/netlify.toml       /404  404!
/FREIGHT-DESK.txt   /404  404!

# Freight Desk (/freight/*) is guarded by netlify/edge-functions/freight-gate.js,
# which admits portal members and holders of a single-use client link.

# Public authentication pages
/login /login.html 200
/login.html /login.html 200

# Protected application shell
/app /app/index.html 200! Role=member
/app/ /app/index.html 200! Role=member
/app/* /app/index.html 200! Role=member
/app /login 401!
/app/ /login 401!
/app/* /login 401!

# Protect application source and data from unauthenticated requests
/src/* /src/:splat 200! Role=member
/src/* /login 401!
/styles.css /styles.css 200! Role=member
/styles.css /login 401!
